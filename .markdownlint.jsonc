// markdownlint 규칙은 이 파일 한 곳에만 둔다. 검사 대상(외부 스킬 제외)은 scripts/check.sh 에 있다.
{
  "default": true,
  // 한국어 문장은 한 문장 한 줄로 쓴다. 80자 줄바꿈은 문장을 끊어 diff만 어지럽힌다
  "MD013": false,
  // 표는 |---| 압축 형식으로 통일해 쓴다. 열 맞춤을 강제하면 한글 폭 때문에 표마다 공백 diff가 생긴다
  "MD060": false,
  // 템플릿의 <빈칸>, <N>, <SHA> 같은 자리표시자가 HTML 태그로 오인된다
  "MD033": false,
  // GitHub PR, 이슈 양식은 본문에 들어가므로 ## 부터 시작하는 것이 맞다
  "MD041": false
}
