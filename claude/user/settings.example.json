{
  "permissions": {
    "allow": [
      "Bash(git stash:*)",
      "Bash(git checkout:*)"
    ],
    "ask": [
      "Bash(gh api:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/plugins/cache/ponytail/ponytail/5.3.2/hooks/ponytail-statusline.sh\""
  },
  "enabledPlugins": {
    "vercel@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "playwright@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "theme": "dark",
  "preferredNotifChannel": "iterm2",
  "autoCompactEnabled": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
